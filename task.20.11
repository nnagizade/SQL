------
SELECT LENGTH(SOBE_ADI),VSIZE(SOBE_ADI) FROM SOBELER;
---------
SELECT AD FROM ISCILER
WHERE SOBE_ID IS NULL;
------------
SELECT s.sobe_adi
FROM sobeler s
WHERE EXISTS (
    SELECT 1
    FROM isciler i
    WHERE i.sobe_id = s.sobe_id
);
------------
SELECT SOBE_ADI FROM SOBELER
WHERE SOBE_ID NOT IN (SELECT SOBE_ID FROM ISCILER);
---NULL IS UNKNOWN , FIX IS SUBQUERY
--------
SELECT s.sobe_adi
FROM sobeler s
WHERE NOT EXISTS (
    SELECT 1
    FROM isciler i
    WHERE i.sobe_id = s.sobe_id
);
---------
SELECT D.DEPARTMENT_NAME
FROM HR.EMPLOYEES E
WHERE NOT EXISTS (
    SELECT 1
    FROM HR.DEPARTMENTS D
    WHERE D.DEPARTMENT_ID = E.DEPARTMENT_ID
);
-----------
SELECT E.FIRST_NAME,E.LAST_NAME
FROM HR.EMPLOYEES E
WHERE EXISTS (
    SELECT 1
    FROM HR.EMPLOYEES D
    WHERE E.EMPLOYEE_ID = D.MANAGER_ID
);
----------
SELECT TO_DATE('25/12/2024 14:30:00', 'DD/MM/YYYY HH24:MI:SS') AS tarix_deyer
FROM dual;
-----------
SELECT TO_DATE('2025-Nov-09 09:15 PM', 'YYYY-MON-DD HH:MI PM') AS tarix_deyer
FROM dual;
-----------
SELECT FIRST_NAME,LAST_NAME,SALARY,HIRE_DATE FROM HR.EMPLOYEES
WHERE HIRE_DATE > DATE '2007-01-01' AND SALARY > 8000
ORDER BY HIRE_DATE DESC;
------------
SELECT FIRST_NAME FROM HR.EMPLOYEES
WHERE HIRE_DATE BETWEEN DATE '2005-01-01' AND DATE '2005-12-31';
--------------
SELECT employee_id,
       first_name,
       last_name,
       TO_CHAR(hire_date, 'DD.MM.YYYY') AS hire_date_NEW
FROM hr.employees
FETCH FIRST 10 ROWS ONLY;
------------
SELECT employee_id,
       first_name,
       last_name,
       hire_date,
       ADD_MONTHS(hire_date, 3) AS probation_end_date
FROM hr.employees;
------------
HR.EMPLOYEES cədvəlində yalnız May ayında (ilindən asılı olmayaraq)
 işə qəbul olunan işçilərin ad, soyad və işə qəbul tarixlərini tapın.
SELECT FIRST_NAME,LAST_NAME,HIRE_DATE FROM HR.EMPLOYEES
WHERE TO_CHAR(HIRE_DATE, 'FMMonth') = 'May';
---------

SELECT E.FIRST_NAME,E.LAST_NAME
FROM HR.EMPLOYEES E
WHERE EXISTS (
    SELECT 1
    FROM HR.EMPLOYEES D
    WHERE E.EMPLOYEE_ID = D.MANAGER_ID
);

SELECT s.sobe_adi
FROM sobeler s
WHERE EXISTS (
    SELECT 1
    FROM isciler i
    WHERE i.sobe_id = s.sobe_id
);

CREATE TABLE LAYIHELER (
    LAYIHE_ID   number(4) PRIMARY KEY,
    LAYIHE_KODU  char(6),
    LAYIHE_ADI  varchar(50),
    BUDCE number(8, 2)
);
INSERT INTO LAYIHELER VALUES (1111, NULL, NULL,123456.789);
SELECT BUDCE FROM LAYIHELER;

CREATE TABLE sobeler (
    sobe_id   number(5) PRIMARY KEY,
    sobe_adi  char(30)
);
CREATE TABLE isciler (
    isci_id  NUMBER PRIMARY KEY,  -- 1) 
    ad       VARCHAR2(30),
    sobe_id  NUMBER
);


